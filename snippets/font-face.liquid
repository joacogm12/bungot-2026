{%- comment -%}
  @font-face de las fuentes self-hosted. Van inline en el <head> y no en
  base.css porque necesitan asset_url de Liquid para resolver la URL del CDN.

  Los unicode-range salen tal cual de Google Fonts: hacen que latin-ext solo se
  descargue si la página realmente usa esos caracteres.
{%- endcomment -%}

<style>
  /* Fredoka salió del tema: la display de todo el sitio ahora es Anton (abajo)
     y el cuerpo sigue en Inter. Los .woff2 de Fredoka se quedan en assets por
     si se revierte, pero sin @font-face nadie los descarga. */

  /* BROOKLINE Condensed — 400 — la tipografía DEL LOGOTIPO.
     font-display: block y no swap como las demás, a propósito: acá no se está
     pintando texto cualquiera sino el nombre de la marca. Preferimos que tarde
     un instante en aparecer a que se vea un segundo con las letras equivocadas
     y después salte. Como se precarga, ese instante es mínimo. */
  @font-face {
    font-family: 'Brookline';
    font-style: normal;
    font-weight: 400;
    font-display: block;
    src: url({{ 'brookline-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Brookline';
    font-style: normal;
    font-weight: 400;
    font-display: block;
    src: url({{ 'brookline-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  /* Anton — 400 (peso único) — la bajada de la portada ("¡PARA CHUPARSE LAS
     PATAS!"). El logotipo ya no la usa (pasó a Brookline), pero esta sí.
     Self-hosted como las demás: el tema no pide fuentes a Google en runtime.
     Anton es OFL, así que servirla desde el CDN de la tienda está permitido. */
  @font-face {
    font-family: 'Anton';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'anton-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Anton';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'anton-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  /* Bayon — 400 (peso único) — las cifras y títulos del recibo del carrito.
     Solo trae subset latin (es una fuente khmer+latin y el khmer acá sobra).
     Self-hosted como las demás, OFL igual que Anton: nada de Google Fonts en
     runtime. */
  @font-face {
    font-family: 'Bayon';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ 'bayon-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* Inter — variable 400..600 — body copy */
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url({{ 'inter-latin.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url({{ 'inter-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
</style>
