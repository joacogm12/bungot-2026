{%- comment -%} Banner marquee animado, idea tomada de gethapply.com {%- endcomment -%}

{%- liquid
  assign msg = section.settings.message | default: 'Envío gratis a partir de $15.000'
-%}

<div class="marquee" style="--marquee-speed: {{ section.settings.speed }}s;">
  {%- comment -%}
    El track se duplica y se anima -50%: así el loop es continuo y sin salto.
    aria-hidden en la copia para que el lector de pantalla no lo lea dos veces.
  {%- endcomment -%}
  <div class="marquee__track">
    <div class="marquee__item">
      {%- for i in (1..6) -%}<span>{{ msg }}</span>{%- endfor -%}
    </div>
    <div class="marquee__item" aria-hidden="true">
      {%- for i in (1..6) -%}<span>{{ msg }}</span>{%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Marquee de anuncios",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Mensaje",
      "default": "Envío gratis en compras superiores a $500 · Código BUNGOT10",
      "info": "El monto es un placeholder: la tienda opera en MXN, ajustalo al umbral real."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Velocidad",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "default": 26,
      "info": "Segundos por vuelta completa. Más alto = más lento."
    }
  ],
  "presets": [{ "name": "Marquee de anuncios" }]
}
{% endschema %}
