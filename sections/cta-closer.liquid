{%- comment -%}
  Sección de cierre estilo garcy.studio: titular GIGANTE arriba, una línea de
  marca, un párrafo con check a la izquierda, un CÍRCULO con el CTA flotando a la
  derecha, y una fila de links abajo. Fondo navy (igual que "hecho en familia").
{%- endcomment -%}

<section
  class="closer"
  style="--cl-bg: {{ section.settings.bg }}; --cl-fg: {{ section.settings.fg }}; --cl-accent: {{ section.settings.accent }};"
>
  <div class="wrap closer__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="closer__head">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}

    {%- if section.settings.tagline != blank -%}
      <p class="closer__tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="closer__body">
        <span class="closer__check" aria-hidden="true">✔</span>
        {{ section.settings.body }}
      </p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a
        class="closer__circle"
        href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
      >{{ section.settings.cta_label }}</a>
    {%- endif -%}

    <div class="closer__foot">
      {%- if section.settings.foot_menu != blank and section.settings.foot_menu.links.size > 0 -%}
        <span class="closer__links">
          {%- for link in section.settings.foot_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </span>
      {%- else -%}
        <span></span>
      {%- endif -%}
      <span class="closer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cierre / CTA",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Titular",
      "default": "Elegí sus premios,\ny a mover la cola",
      "info": "Va ENORME, arriba. Enter para partir en renglones."
    },
    { "type": "text", "id": "tagline", "label": "Línea de marca", "default": "Comida real ▶▶ Perros felices" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Párrafo",
      "default": "Proteína real deshidratada en lotes chicos. Un solo ingrediente, sin conservadores ni rellenos — nada que no le darías a tu propio perro."
    },
    { "type": "text", "id": "cta_label", "label": "Botón (círculo)", "default": "¡Pedí la tuya!" },
    { "type": "url", "id": "cta_url", "label": "Link del botón", "info": "Vacío = todos los productos." },
    { "type": "link_list", "id": "foot_menu", "label": "Links de abajo", "info": "Ej.: Contacto, Preguntas, Términos. Opcional." },
    { "type": "header", "content": "Colores" },
    {
      "type": "color",
      "id": "bg",
      "label": "Fondo",
      "default": "#163C69",
      "info": "PANTONE 654 (navy), el mismo de la sección de la ola."
    },
    { "type": "color", "id": "fg", "label": "Texto", "default": "#F7F1E3" },
    { "type": "color", "id": "accent", "label": "Acento (círculo y links)", "default": "#E94925" }
  ],
  "presets": [{ "name": "Cierre / CTA" }]
}
{% endschema %}
