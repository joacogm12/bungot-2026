<section class="pdp">
  <div class="wrap pdp__inner">
    <div class="pdp__media" style="--pdp-bg: {{ section.settings.bg }};">
      {%- if product.featured_image -%}
        <img
          class="pdp__img"
          src="{{ product.featured_image | image_url: width: 900 }}"
          srcset="
            {{ product.featured_image | image_url: width: 450 }} 450w,
            {{ product.featured_image | image_url: width: 900 }} 900w,
            {{ product.featured_image | image_url: width: 1400 }} 1400w"
          sizes="(max-width: 900px) 92vw, 46vw"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="900"
          height="900"
          fetchpriority="high"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'pdp__img' }}
      {%- endif -%}

      {%- if product.images.size > 1 -%}
        <div class="pdp__thumbs">
          {%- for image in product.images limit: 5 -%}
            <img
              class="pdp__thumb"
              src="{{ image | image_url: width: 160 }}"
              alt="{{ image.alt | escape }}"
              width="80"
              height="80"
              loading="lazy"
            >
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp__copy">
      <nav class="pdp__crumbs" aria-label="{{ 'accessibility.breadcrumbs' | t }}">
        <a href="{{ routes.all_products_collection_url }}">{{ 'products.back' | t }}</a>
      </nav>

      <h1 class="pdp__title">{{ product.title }}</h1>

      <div class="pdp__price">
        {%- if product.compare_at_price > product.price -%}
          <s>{{ product.compare_at_price | money }}</s>
        {%- endif -%}
        <span>{{ product.price | money }}</span>
      </div>

      {%- if product.tags.size > 0 -%}
        <div class="slide__tags">
          {%- for tag in product.tags limit: 4 -%}
            <span class="slide__tag">{{ tag }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, class: 'pdp__form' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="pdp__option">
              <label class="pdp__label" for="opt-{{ forloop.index }}">{{ option.name }}</label>
              <select
                class="pdp__select"
                id="opt-{{ forloop.index }}"
                name="options[{{ option.name | escape }}]"
              >
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                    {{ value }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        <button
          class="btn btn--coral pdp__add"
          type="submit"
          name="add"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          {%- if product.selected_or_first_available_variant.available -%}
            {{ 'products.card.buy' | t }} 🐾
          {%- else -%}
            {{ 'products.card.sold_out' | t }}
          {%- endif -%}
        </button>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="pdp__desc rte">{{ product.description }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Producto",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Fondo de la foto",
      "default": "#F6A762",
      "info": "Igual que las tarjetas del grid: fondo de color sólido detrás del producto."
    }
  ]
}
{% endschema %}
