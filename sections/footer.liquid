{%- comment -%}
  Footer estilo "happly": arriba a la izquierda el tagline + alta al newsletter
  (con el 10%), a la derecha las columnas de links; en el medio el WORDMARK
  gigante a todo el ancho; abajo la barra legal. (La franja de disclaimer se
  quitó a pedido en el rediseño responsive de 2026-08.)
{%- endcomment -%}

<footer
  class="footer"
  style="--ft-bg: {{ section.settings.bg }}; --ft-fg: {{ section.settings.fg }}; --ft-btn-bg: {{ section.settings.btn_bg }}; --ft-btn-fg: {{ section.settings.btn_fg }};"
>
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__lead">
        {%- if section.settings.tagline != blank -%}
          <h2 class="footer__tagline">{{ section.settings.tagline | newline_to_br }}</h2>
        {%- endif -%}

        {%- if section.settings.signup_text != blank -%}
          <p class="footer__signup-label">{{ section.settings.signup_text }}</p>
        {%- endif -%}

        {%- comment -%}
          El alta se manda por fetch (initFooterSignup en theme.js) y la
          confirmación se queda aquí mismo: con el envío nativo la página
          recargaba y no se notaba que algo había pasado. Sin JS el form navega
          y estos mismos estados los pinta Liquid a la vuelta.
        {%- endcomment -%}
        {%- form 'customer', class: 'footer__signup' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="footer__signup-input"
            placeholder="{{ section.settings.signup_placeholder | default: 'tu@email.com' }}"
            aria-label="{{ 'footer.signup.email_label' | t }}"
            required
          >
          <button
            type="submit"
            class="footer__signup-btn"
            data-signup-btn
            data-sending="{{ 'footer.signup.sending' | t | escape }}"
          >{{ section.settings.signup_button | default: 'Suscribirme' }}</button>
          <p class="footer__signup-ok" data-signup-ok role="status"{% unless form.posted_successfully? %} hidden{% endunless %}>
            <svg class="footer__signup-check" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
              <circle cx="16" cy="16" r="14"/>
              <path d="M9.5 16.5l4.5 4.5 8.5-9.5"/>
            </svg>
            <span>
              <strong>{{ 'footer.signup.ok_title' | t }}</strong>
              {{ 'footer.signup.ok_text' | t }}
            </span>
          </p>
          <p class="footer__signup-msg" data-signup-error role="alert"{% unless form.errors %} hidden{% endunless %}>{{ 'footer.signup.error' | t }}</p>
        {%- endform -%}
      </div>

      <nav class="footer__nav" aria-label="Enlaces del pie">
        {%- for block in section.blocks -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h3 class="footer__heading">{{ block.settings.title }}</h3>
            <ul class="footer__links">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}

        {%- liquid
          assign has_social = false
          if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_whatsapp != blank
            assign has_social = true
          endif
        -%}
        {%- if has_social -%}
          <div class="footer__col">
            <h3 class="footer__heading">Redes</h3>
            <ul class="footer__links">
              {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
              {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener" target="_blank">Facebook</a></li>{%- endif -%}
              {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
              {%- if settings.social_whatsapp != blank -%}<li><a href="{{ settings.social_whatsapp }}" rel="noopener" target="_blank">WhatsApp</a></li>{%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      </nav>
    </div>
  </div>

  {%- comment -%} Wordmark gigante a todo el ancho (decorativo). {%- endcomment -%}
  <div class="footer__wordmark" aria-hidden="true">{{ shop.name }}</div>

  <div class="wrap">
    <div class="footer__bottom">
      <span>{{ 'footer.rights' | t }} · &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- if section.settings.policy_menu != blank and section.settings.policy_menu.links.size > 0 -%}
        <span class="footer__policies">
          {%- for link in section.settings.policy_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </span>
      {%- endif -%}
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Frase grande",
      "default": "La porción justa\nde bueno",
      "info": "Va grande arriba a la izquierda. Enter para partir en renglones."
    },
    {
      "type": "text",
      "id": "signup_text",
      "label": "Texto del alta",
      "default": "Sumate a BUNGOT y llevate 10% en tu primer pedido"
    },
    { "type": "text", "id": "signup_placeholder", "label": "Placeholder del email", "default": "tu@email.com" },
    { "type": "text", "id": "signup_button", "label": "Botón del alta", "default": "Suscribirme" },
    { "type": "link_list", "id": "policy_menu", "label": "Menú legal (abajo a la derecha)", "info": "Ej.: Política de privacidad, Términos. Opcional." },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#E94925" },
    { "type": "color", "id": "fg", "label": "Texto", "default": "#F7F1E3" },
    { "type": "color", "id": "btn_bg", "label": "Fondo del botón", "default": "#2E5FA0" },
    { "type": "color", "id": "btn_fg", "label": "Texto del botón", "default": "#F7F1E3" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Columna de links",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Tienda" },
        { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
