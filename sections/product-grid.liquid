{%- comment -%}
  Grid de productos con chips de filtro — la sección más "BUNGOT" de todas.
  Mantiene la firma del sitio actual: header verde, contador arriba a la
  derecha, chips con emoji y tarjetas de color rotando.

  Los chips filtran del lado del cliente por tag de producto (ver theme.js).
  Sirve porque el catálogo son ~13 productos y entran todos en una página;
  si el catálogo crece más allá de `limit`, conviene pasar a filtros nativos
  de Shopify con recarga de página.
{%- endcomment -%}

{%- liquid
  assign col = collections[section.settings.collection]
  if col == blank or col.products.size == 0
    assign col = collections.all
  endif

  assign limit = section.settings.limit | default: 24
-%}

<section class="collection" data-collection>
  <div class="wrap">
    <div class="collection__head">
      <h2 class="collection__title">{{ section.settings.title }}</h2>
      <span class="collection__count" data-count data-label="{{ 'collections.count_label' | t }}">
        {{- col.products.size }} {{ 'collections.count_label' | t -}}
      </span>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="filters" role="group" aria-label="{{ 'collections.filter_by' | t }}">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">
          {{ section.settings.all_label }}
        </button>

        {%- for block in section.blocks -%}
          <button
            class="chip"
            type="button"
            data-filter="{{ block.settings.tag | downcase | escape }}"
            aria-pressed="false"
            {{ block.shopify_attributes }}
          >
            <span aria-hidden="true">{{ block.settings.emoji }}</span>
            {{ block.settings.label }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="product-grid">
      {%- for product in col.products limit: limit -%}
        {% render 'product-card', product: product, index: forloop.index0 %}
      {%- else -%}
        {%- for i in (1..8) -%}
          <div class="card" style="--card-bg: #F6A762;">
            <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'card__img' }}</div>
            <div class="card__foot">
              <h3 class="card__name">{{ 'onboarding.product_title' | t }}</h3>
              <span class="card__price">$70</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}

      <p class="collection__empty" data-empty hidden>{{ 'collections.empty' | t }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grid de productos",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Productos" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    {
      "type": "range",
      "id": "limit",
      "label": "Máximo de productos",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    },
    { "type": "text", "id": "all_label", "label": "Texto del chip 'todos'", "default": "✨ Todos" }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Chip de filtro",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🐕" },
        { "type": "text", "id": "label", "label": "Texto", "default": "Perros" },
        {
          "type": "text",
          "id": "tag",
          "label": "Qué filtra",
          "default": "productos-perros,perros",
          "info": "Matchea contra el tag, el tipo de producto o el handle de colección. Podés poner varios separados por coma y alcanza con que coincida uno."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grid de productos",
      "blocks": [
        { "type": "filter", "settings": { "emoji": "🐕", "label": "Perros", "tag": "productos-perros,perros" } },
        { "type": "filter", "settings": { "emoji": "🐈", "label": "Gatos", "tag": "productos-gatos,gatos" } },
        { "type": "filter", "settings": { "emoji": "🦴", "label": "Huesos", "tag": "huesos,hueso" } },
        { "type": "filter", "settings": { "emoji": "🧸", "label": "Juguetes", "tag": "juguete,juguetes" } }
      ]
    }
  ]
}
{% endschema %}
