<section
  class="testimonials"
  style="--tm-bg: {{ section.settings.bg }}; --tm-fg: {{ section.settings.fg }};"
>
  <div class="wrap">
    {%- if section.settings.title != blank -%}
      <h2 class="testimonials__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          {%- if block.settings.stars > 0 -%}
            <div class="testimonial__stars" aria-label="{{ block.settings.stars }} / 5">
              <span aria-hidden="true">
                {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
              </span>
            </div>
          {%- endif -%}
          <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
          <figcaption class="testimonial__who">{{ block.settings.who }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonios",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Lo que dicen (los dueños)" },
    {
      "type": "color",
      "id": "bg",
      "label": "Fondo",
      "default": "#163C69",
      "info": "PANTONE 654 C, el mismo de la sección de la ola: las dos se leen como un solo bloque."
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Título",
      "default": "#FFFFFF",
      "info": "Sobre un fondo oscuro tiene que ir claro. Las tarjetas van blancas aparte."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        { "type": "range", "id": "stars", "label": "Estrellas", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review" },
        { "type": "text", "id": "who", "label": "Nombre" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonios",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "Escucha el ruido de la bolsa desde el otro lado de la casa. No falla nunca.",
            "who": "Caro y Nube 🐕"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "Probé mil premios y siempre volvía uno con olor a químico. Estos huelen a comida de verdad.",
            "who": "Mati y Rocco"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "stars": 5,
            "quote": "Las patas de pollo le duran un rato largo y quedan los dientes impecables. Compro fijo.",
            "who": "Juli y Lola"
          }
        }
      ]
    }
  ]
}
{% endschema %}
