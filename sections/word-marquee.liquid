{%- comment -%}
  Marquee grande tipo cinta: palabras enormes con fotitos intercaladas, corriendo
  sin parar (ref: cinta "TOULOUSE · LYON" con fotos). Va debajo de la ola.

  Cómo hace el loop infinito: se arma UNA secuencia (palabra + imagen, repetido) y
  se imprime DOS veces dentro del track; la animación corre el track -50%, o sea
  exactamente el ancho de una secuencia, así el empalme es invisible y no salta.

  Las imágenes se ciclan de la lista (modulo), así se reparten entre las palabras.
  Son decorativas: alt vacío, y la segunda copia va aria-hidden para que el lector
  de pantalla no lea todo dos veces.
{%- endcomment -%}

{%- liquid
  assign word_list = section.settings.words | split: ','
  assign img_list = section.settings.images | split: ','
  assign img_count = img_list | size
-%}

{%- capture seq -%}
  {%- for w in word_list -%}
    {%- assign word = w | strip -%}
    {%- if word != blank -%}
      <span class="wmarquee__word">{{ word | upcase }}</span>
    {%- endif -%}
    {%- if img_count > 0 -%}
      {%- assign ii = forloop.index0 | modulo: img_count -%}
      {%- assign img = img_list[ii] | strip -%}
      {%- if img != blank -%}
        {%- comment -%} Fotitos decorativas, assets configurables y dimensionadas por CSS: sin w/h fija. {%- endcomment -%}
        {%- # theme-check-disable ImgWidthAndHeight -%}
        <img class="wmarquee__img" src="{{ img | asset_url }}" alt="" aria-hidden="true" loading="lazy">
        {%- # theme-check-enable ImgWidthAndHeight -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section
  class="wmarquee"
  style="--wmq-bg: {{ section.settings.bg }}; --wmq-fg: {{ section.settings.fg }}; --wmq-speed: {{ section.settings.speed }}s;"
  aria-label="{{ section.settings.words | strip }}"
>
  <div class="wmarquee__track">
    <div class="wmarquee__seq">{{ seq }}</div>
    <div class="wmarquee__seq" aria-hidden="true">{{ seq }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Cinta / Marquee",
  "settings": [
    {
      "type": "textarea",
      "id": "words",
      "label": "Palabras",
      "default": "Proteína real, Un solo ingrediente, Sin rellenos, Hecho en casa, Para chuparse las patas",
      "info": "Separá con comas. Se muestran en MAYÚSCULAS y corren sin parar."
    },
    {
      "type": "textarea",
      "id": "images",
      "label": "Fotitos (assets del tema)",
      "default": "bungot-sticker-buldog.webp, bungot-sticker-manada.webp, bungot-sticker-greta.png, bungot-sticker-bache.png",
      "info": "Nombres de archivo dentro de assets/, separados por coma. Se intercalan y se reparten entre las palabras. Decorativas."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Velocidad",
      "min": 15,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 40,
      "info": "Segundos por vuelta completa. Más alto = más lento."
    },
    { "type": "header", "content": "Colores" },
    {
      "type": "color",
      "id": "bg",
      "label": "Fondo",
      "default": "#F59C26",
      "info": "PANTONE 1375 (naranja). Va después de la ola navy, así que un color cálido pega fuerte."
    },
    { "type": "color", "id": "fg", "label": "Texto", "default": "#F7F1E3" }
  ],
  "presets": [{ "name": "Cinta / Marquee" }]
}
{% endschema %}
