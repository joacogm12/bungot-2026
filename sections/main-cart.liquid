<section class="page-section">
  <div class="wrap">
    <h1 class="page-section__title">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <p class="cart-empty__emoji" aria-hidden="true">🦴</p>
        <p>{{ 'cart.empty' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.keep_shopping' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <ul class="cart-list">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__media">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    alt="{{ item.image.alt | default: item.product.title | escape }}"
                    width="100"
                    height="100"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              <div class="cart-item__info">
                <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.variant.title contains 'Default' -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- if item.selling_plan_allocation -%}
                  <p class="cart-item__variant">{{ 'cart.plan_prefix' | t }} {{ item.selling_plan_allocation.selling_plan.name }}</p>
                {%- endif -%}
                <p class="cart-item__price">{{ item.final_line_price | money }}</p>
              </div>

              <div class="cart-item__qty">
                <label class="visually-hidden" for="qty-{{ forloop.index }}">
                  {{ 'cart.quantity' | t }}
                </label>
                <input
                  class="cart-item__input"
                  id="qty-{{ forloop.index }}"
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  inputmode="numeric"
                >
                <a class="cart-item__remove" href="{{ item.url_to_remove }}" aria-label="{{ 'cart.remove' | t }}">✕</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart-foot">
          <div class="cart-foot__total">
            <span>{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="cart-foot__note">{{ 'cart.taxes_note' | t }}</p>
          <div class="cart-foot__actions">
            <button class="btn btn--ghost" type="submit" name="update">{{ 'cart.update' | t }}</button>
            <button class="btn btn--coral" type="submit" name="checkout">{{ 'cart.checkout' | t }} 🐾</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Carrito" }
{% endschema %}
