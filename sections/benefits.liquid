{%- comment -%}
  Tarjetas de beneficios cortas con ícono — patrón tomado de rockyshothoney.com
{%- endcomment -%}

<section class="benefits">
  <div class="wrap">
    {%- if section.settings.title != blank -%}
      <h2 class="benefits__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="benefits__grid">
      {%- for block in section.blocks -%}
        <div class="benefit" style="--benefit-bg: {{ block.settings.bg }};" {{ block.shopify_attributes }}>
          <div class="benefit__icon" aria-hidden="true">{{ block.settings.icon }}</div>
          <h3 class="benefit__title">{{ block.settings.title }}</h3>
          <p class="benefit__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beneficios",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Por qué BUNGOT" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji", "default": "🥩" },
        { "type": "text", "id": "title", "label": "Título", "default": "Ingredientes reales" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Un solo ingrediente. Lo que dice la etiqueta es lo que hay adentro." },
        { "type": "color", "id": "bg", "label": "Fondo", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beneficios",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "🥩",
            "title": "Ingredientes reales",
            "text": "Un solo ingrediente. Lo que dice la etiqueta es lo que hay adentro.",
            "bg": "#F6A762"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🔥",
            "title": "Lotes chicos",
            "text": "Deshidratado de a poco, como corresponde. Nada de producción en masa.",
            "bg": "#88CBC4"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🚫",
            "title": "Sin aditivos",
            "text": "Cero conservantes, colorantes y rellenos raros. Cero.",
            "bg": "#FED140"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🐕",
            "title": "Aprobado por perros",
            "text": "Probado por los más exigentes: los que no saben mentir.",
            "bg": "#EB5F7A"
          }
        }
      ]
    }
  ]
}
{% endschema %}
