{%- comment -%}
  Grid de la página de colección (shop). Los chips son FILTROS de producto
  (client-side, ver initFilters en theme.js): matchean contra el data-tags de
  cada tarjeta (tags + tipo + colecciones). El catálogo entra en una página, así
  que alcanza con filtrar por JS; si crece, conviene pasar a filtros nativos.
{%- endcomment -%}

<section class="collection collection--page" data-collection>
  <div class="wrap">
    <div class="collection__head">
      <h1 class="collection__title">{{ collection.title }}</h1>
      <span class="collection__count" data-count data-label="{{ 'collections.count_label' | t }}">
        {{- collection.products_count }} {{ 'collections.count_label' | t -}}
      </span>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="filters" role="group" aria-label="{{ 'collections.filter_by' | t }}">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">
          {{ section.settings.all_label }}
        </button>

        {%- for block in section.blocks -%}
          <button
            class="chip"
            type="button"
            data-filter="{{ block.settings.tag | downcase | escape }}"
            aria-pressed="false"
            {{ block.shopify_attributes }}
          >
            <span aria-hidden="true">{{ block.settings.emoji }}</span>
            {{ block.settings.label }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if collection.description != blank -%}
      <div class="collection__desc rte">{{ collection.description }}</div>
    {%- endif -%}

    {%- paginate collection.products by 24 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- else -%}
          <p class="collection__empty">{{ 'collections.empty' | t }}</p>
        {%- endfor -%}

        <p class="collection__empty" data-empty hidden>{{ 'collections.empty' | t }}</p>
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'accessibility.pagination' | t }}">
          {%- if paginate.previous -%}
            <a class="chip" href="{{ paginate.previous.url }}">← {{ 'general.previous' | t }}</a>
          {%- endif -%}
          {%- if paginate.next -%}
            <a class="chip" href="{{ paginate.next.url }}">{{ 'general.next' | t }} →</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "all_label", "label": "Texto del chip 'todos'", "default": "✨ Todos" }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Chip de filtro",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🐕" },
        { "type": "text", "id": "label", "label": "Texto", "default": "Perros" },
        {
          "type": "text",
          "id": "tag",
          "label": "Qué filtra",
          "default": "productos-perros,perros",
          "info": "Matchea contra el tag, el tipo de producto o el handle de colección. Podés poner varios separados por coma y alcanza con que coincida uno."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colección",
      "blocks": [
        { "type": "filter", "settings": { "emoji": "🐕", "label": "Perros", "tag": "productos-perros,perros" } },
        { "type": "filter", "settings": { "emoji": "🐈", "label": "Gatos", "tag": "productos-gatos,gatos" } },
        { "type": "filter", "settings": { "emoji": "🦴", "label": "Huesos", "tag": "huesos,hueso" } },
        { "type": "filter", "settings": { "emoji": "🧸", "label": "Juguetes", "tag": "juguete,juguetes" } }
      ]
    }
  ]
}
{% endschema %}
