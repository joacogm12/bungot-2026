{%- comment -%}
  BUNGOT — Página de producto (PDP). Estructura de split fijo 50/50:

    1. El split — fila de ALTURA FIJA (960px): izquierda la galería sobre el
       color de la familia, derecha todo lo de comprar sobre crema. La mitad
       izquierda nunca cambia de alto.
    2. Cinturón de beneficios — banda verde profundo a sangre.
    3. Opiniones de los clientes — con popup para escribir una.
    4. Venta cruzada — última sección antes del footer.

  La foto NO va suelta sobre el color: va dentro de un marco crema con borde,
  así se ven bien tanto la bolsa recortada como las fotos de estudio que traen
  su propio fondo (el marco cambia object-fit y padding según el caso).

  El header y el footer son los GLOBALES del tema (header-group / footer-group):
  esta sección no dibuja nav propio. El contador que se actualiza al agregar es
  el [data-cart-count] del header de la landing.

  Todo se llena con el producto real; los section.settings son overrides
  opcionales para el customizer.
{%- endcomment -%}

{{ 'producto.css' | asset_url | stylesheet_tag }}

{%- liquid
  # --- Color de la familia (fondo del panel izquierdo) ---
  # 1) override del customizer (normalmente vacío) · 2) card-color.liquid
  # (única fuente de verdad del color de un producto: el de su familia en el
  # catálogo, así la galería es del mismo color que su tarjeta) ·
  # 3) naranja del diseño, para cuando no hay producto (preview del editor).
  assign fam = section.settings.family_color
  if fam == blank and product != blank
    # El índice va por product.id para que el color no cambie entre visitas;
    # en cuanto el producto tenga custom.card_color, ese gana y el índice sobra.
    capture fam_from_card
      render 'card-color', product: product, index: product.id
    endcapture
    assign fam = fam_from_card | strip
  endif
  if fam == blank
    assign fam = '#E24E2E'
  endif

  # --- Datos de la etiqueta (metafields custom.*) ---
  # Vienen del archivo de etiquetas cargado en Shopify. Son la fuente de verdad;
  # los section.settings solo mandan si el metafield está vacío.
  assign mf = product.metafields.custom
  assign gramaje = mf.gramaje.value

  # --- Textos de la columna derecha (override → producto → default) ---
  # El antetítulo es el beneficio principal de la etiqueta ("Masa muscular",
  # "Salud dental"): dice más que un genérico y ya está cargado por producto.
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = mf.beneficio_principal.value | default: product.type
  endif

  assign title = section.settings.title | default: product.title
  if title == blank
    assign title = 'onboarding.product_title' | t
  endif

  assign lead = section.settings.lead
  if lead == blank
    # Corto a propósito: la columna tiene alto fijo, y un párrafo largo se come
    # el espacio del acordeón hasta dejarlo en su mínimo.
    assign lead = product.description | strip_html | truncatewords: 26
  endif

  # --- Cifras ---
  # Salen del análisis garantizado de la etiqueta, no de un texto fijo:
  #   1. la proteína cruda real del producto,
  #   2. cuántos ingredientes tiene — la etiqueta dice "UNICO INGREDIENTE"
  #      cuando es uno solo; si no, se cuentan los separados por coma,
  #   3. conservadores: siempre cero, es la promesa de la marca.
  assign stat1_value = section.settings.stat1_value
  assign stat1_label = section.settings.stat1_label
  if stat1_value == blank and mf.proteina_cruda.value != blank
    assign stat1_value = mf.proteina_cruda.value | times: 1 | round | append: '%'
  endif

  assign stat2_value = section.settings.stat2_value
  assign stat2_label = section.settings.stat2_label
  if stat2_value == blank and mf.ingredientes.value != blank
    assign ing_txt = mf.ingredientes.value | upcase
    if ing_txt contains 'UNICO INGREDIENTE'
      assign ing_count = 1
    else
      assign ing_parts = mf.ingredientes.value | split: ','
      assign ing_count = ing_parts.size
    endif
    assign stat2_value = ing_count
    if stat2_label == blank
      if ing_count == 1
        assign stat2_label = 'sections.producto.ingredient_one' | t
      else
        assign stat2_label = 'sections.producto.ingredient_other' | t
      endif
    endif
  endif

  assign stat3_value = section.settings.stat3_value
  assign stat3_label = section.settings.stat3_label

  # --- Galería ---
  # Solo las fotos que el producto trae en Shopify, a sangre (cover): las fotos
  # de estudio ya vienen con su propio fondo, así que llenan el marco completo
  # en lugar de flotar con padding. Ya NO se rellena con assets del tema hasta
  # completar cuatro miniaturas (antes se colaban fotos que no estaban en el
  # producto, como la del equipo). El único respaldo es la bolsa del tema, y
  # solo cuando el producto no tiene ninguna foto (preview del customizer); esa
  # sí es un recorte y respira dentro del marco (contain).
  assign fallback_shot = 'bungot-pulmon.webp'

  # Foto grande de arranque: la del producto, o la bolsa de respaldo.
  # El src queda resuelto por Liquid en el HTML — nada de plantillas que el
  # navegador tenga que pedir sin resolver.
  assign bag = section.settings.bag_image | default: product.featured_image
  if bag != blank
    assign bag_src = bag | image_url: width: 1200
    assign bag_alt = bag.alt | default: title
    assign bag_fit = 'cover'
  else
    assign bag_src = fallback_shot | asset_url
    assign bag_alt = 'sections.producto.shot_bag' | t
    assign bag_fit = 'contain'
  endif

  # --- Selectores ---
  # Solo si el producto tiene variantes de verdad (ej. Pulmón de res: 60 g y
  # 190 g). Los productos de una sola presentación NO llevan selector: su
  # contenido se muestra como dato, porque en BUNGOT cada proteína y cada
  # gramaje es un producto aparte, no una opción.
  assign use_real_options = false
  if product != blank and product.has_only_default_variant == false
    assign use_real_options = true
  endif

  assign cur_variant = product.selected_or_first_available_variant

  # --- Suscripción ---
  # Los planes (Shopify Subscriptions) cuelgan del producto; el precio de cada
  # plan es por variante (selling_plan_allocations). Sin planes no se pinta
  # nada y la PDP queda como siempre. Con requires_selling_plan (ej. la Caja)
  # no hay opción de compra única y el primer plan arranca elegido.
  assign has_plans = false
  if product != blank and product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
-%}

<section class="pdpage" data-pdp style="--pd-fam: {{ fam }};">

  {%- comment -%} ---------- 1. El split (fila de 960px mínimo) ---------- {%- endcomment -%}
  <div class="pdsplit">

    {%- comment -%}
      Panel de la galería. La fila arranca en 960px y crece con los desplegables
      de la derecha; las miniaturas y el marco viven juntos dentro de .pdgal,
      que es UNA sola pieza sticky: se mueven en conjunto y quedan centrados en
      la pantalla mientras dura la banda de color (ver el CSS de .pdgal).
    {%- endcomment -%}
    <div class="pdsplit__media">
      <div class="pdgal">
        {%- comment -%}
          La tira sale de product.media (fotos Y videos), no de product.images:
          así un video subido al producto es una miniatura más. El marco ARRANCA
          siempre con una foto (bag = featured_image, que es imagen aunque el
          video vaya primero en el admin): el LCP sigue siendo un <img> con
          fetchpriority y el video no pesa nada hasta que alguien le da play.
          Por eso la foto principal va primera en la tira y el resto en el orden
          del admin, saltando esa misma foto para no repetirla. Los modelos 3D
          no se pintan: el marco no los sabe mostrar. Con una sola pieza no hay
          nada que elegir y la tira sobra.
        {%- endcomment -%}
        {%- liquid
          assign gal_count = product.media.size
          if section.settings.bag_image != blank
            assign gal_count = gal_count | plus: 1
          endif
        -%}
        {%- if gal_count > 1 -%}
        <div class="pdthumbs" role="group" aria-label="{{ 'sections.producto.thumbs' | t }}">
          {%- if bag != blank -%}
            <button
              type="button"
              class="pdthumb is-active"
              data-pd-thumb
              data-kind="image"
              data-full="{{ bag_src }}"
              data-full-alt="{{ bag_alt | escape }}"
              data-fit="cover"
              aria-pressed="true"
            >
              <img src="{{ bag | image_url: width: 200 }}" alt="{{ bag_alt | escape }}" width="92" height="92" loading="lazy">
            </button>
          {%- endif -%}
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              {%- if media.preview_image.src == bag.src -%}{%- continue -%}{%- endif -%}
              <button
                type="button"
                class="pdthumb"
                data-pd-thumb
                data-kind="image"
                data-full="{{ media | image_url: width: 1200 }}"
                data-full-alt="{{ media.alt | default: title | escape }}"
                data-fit="cover"
                aria-pressed="false"
              >
                <img src="{{ media | image_url: width: 200 }}" alt="{{ media.alt | default: title | escape }}" width="92" height="92" loading="lazy">
              </button>
            {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
              {%- comment -%}
                La miniatura es el poster del video con un badge de play. El
                data-ar le dice al marco qué proporción tomar en móvil: un video
                vertical se ve entero, no recortado a cuadrado.
              {%- endcomment -%}
              <button
                type="button"
                class="pdthumb pdthumb--video"
                data-pd-thumb
                data-kind="video"
                data-media="{{ media.id }}"
                data-ar="{{ media.aspect_ratio | default: 1 }}"
                aria-pressed="false"
                aria-label="{{ 'sections.producto.video_thumb' | t }}"
              >
                <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" width="92" height="92" loading="lazy">
                <span class="pdthumb__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- endif -%}

        <div class="pdframe">
          <img
            class="pdframe__img{% if bag_fit == 'cover' %} is-cover{% endif %}"
            src="{{ bag_src }}"
            alt="{{ bag_alt | escape }}"
            width="1200"
            height="1200"
            data-pd-main
            fetchpriority="high"
          >
          {%- comment -%}
            Acá aterriza el video elegido: producto.js clona el <template> del
            video al slot y esconde la foto (setupThumbs). Vacío y oculto
            mientras la persona no elija un video.
          {%- endcomment -%}
          <div class="pdframe__media" data-pd-media-slot hidden></div>
        </div>

        {%- comment -%}
          Navegación a la derecha del marco: anterior / "n de total" / siguiente.
          Va vertical porque la tira de miniaturas también lo es; en móvil se
          acuesta bajo el marco. El total lo corrige producto.js con las
          miniaturas reales (gal_count es una aproximación de Liquid).
        {%- endcomment -%}
        {%- if gal_count > 1 -%}
        <div class="pdnav" data-pd-nav>
          <button type="button" class="pdnav__btn" data-pd-prev aria-label="{{ 'sections.producto.gal_prev' | t }}">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <p class="pdnav__count" aria-live="polite">
            <span data-pd-count-cur>1</span><span class="pdnav__sep" aria-hidden="true">/</span><span class="pdnav__of">{{ 'sections.producto.gal_of' | t }}</span><span data-pd-count-total>{{ gal_count }}</span>
          </p>
          <button type="button" class="pdnav__btn" data-pd-next aria-label="{{ 'sections.producto.gal_next' | t }}">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        {%- endif -%}

        {%- comment -%}
          Un <template> por video. Lo que hay adentro NO carga nada al abrir la
          página (ni el poster, ni el mp4, ni el embed): el navegador solo lo
          parsea. Al elegir la miniatura se clona; el archivo baja hasta que se
          da play (preload="none"), y nunca arranca solo ni con sonido.
        {%- endcomment -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'video' -%}
            <template data-pd-media="{{ media.id }}">
              <figure class="pdvideo" data-media-id="{{ media.id }}">
                <video
                  class="pdvideo__el"
                  preload="none"
                  playsinline
                  poster="{{ media.preview_image | image_url: width: 1200 }}"
                  aria-label="{{ media.alt | default: title | escape }}"
                >
                  {%- comment -%}
                    Liquid solo expone dos fuentes: el HLS (m3u8) y el mp4
                    ORIGINAL (las versiones 480p/720p existen en el CDN pero no
                    llegan a media.sources). Por eso el orden es el mismo que el
                    del video_tag de Shopify: HLS primero, que en Safari/iOS es
                    adaptativo y baja solo la calidad que cabe en la conexión;
                    Chrome/Firefox lo ignoran y caen al mp4.
                  {%- endcomment -%}
                  {%- for s in media.sources -%}
                    {%- if s.format == 'm3u8' -%}
                      <source src="{{ s.url }}" type="{{ s.mime_type }}">
                    {%- endif -%}
                  {%- endfor -%}
                  {%- for s in media.sources -%}
                    {%- if s.format == 'mp4' -%}
                      <source src="{{ s.url }}" type="{{ s.mime_type }}">
                    {%- endif -%}
                  {%- endfor -%}
                </video>
                <button type="button" class="pdvideo__play" data-pd-play aria-label="{{ 'sections.producto.video_play' | t }}">
                  <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                </button>
              </figure>
            </template>
          {%- elsif media.media_type == 'external_video' -%}
            {%- comment -%}
              YouTube/Vimeo: el iframe se crea hasta el play (un embed carga
              cientos de KB solo por existir). Antes, solo el poster.
            {%- endcomment -%}
            <template data-pd-media="{{ media.id }}">
              <figure class="pdvideo" data-media-id="{{ media.id }}" data-embed="{{ media | external_video_url: autoplay: true, playsinline: true }}">
                <img class="pdvideo__poster" src="{{ media.preview_image | image_url: width: 1200 }}" alt="{{ media.alt | default: title | escape }}" width="1200" height="1200">
                <button type="button" class="pdvideo__play" data-pd-play aria-label="{{ 'sections.producto.video_play' | t }}">
                  <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
                </button>
              </figure>
            </template>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.lote != blank -%}
        <p class="pdsplit__lote">{{ section.settings.lote }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Panel de compra. ---------- {%- endcomment -%}
    <div class="pdsplit__buy">
      {%- if eyebrow != blank -%}
        <p class="pdbuy__eyebrow">{{ eyebrow }}</p>
      {%- endif -%}

      <h1 class="pdbuy__title">{{ title }}</h1>

      {%- if lead != blank -%}
        <p class="pdbuy__lead">{{ lead }}</p>
      {%- endif -%}

      {%- comment -%} Tira de tres cifras, separadas por reglas verticales. {%- endcomment -%}
      <dl class="pdstats">
        {%- if stat1_value != blank -%}
          <div class="pdstat">
            <dt class="pdstat__value">{{ stat1_value }}</dt>
            <dd class="pdstat__label">{{ stat1_label }}</dd>
          </div>
        {%- endif -%}
        {%- if stat2_value != blank -%}
          <div class="pdstat">
            <dt class="pdstat__value">{{ stat2_value }}</dt>
            <dd class="pdstat__label">{{ stat2_label }}</dd>
          </div>
        {%- endif -%}
        {%- if stat3_value != blank -%}
          <div class="pdstat">
            <dt class="pdstat__value">{{ stat3_value }}</dt>
            <dd class="pdstat__label">{{ stat3_label }}</dd>
          </div>
        {%- endif -%}
      </dl>

      <form class="pdform" data-pd-form>
        <div class="pdopts">
          {%- if use_real_options -%}
            {%- for opt in product.options_with_values -%}
              <div class="pdopt">
                <span class="pdopt__label">{{ opt.name }}</span>
                <div class="pdopt__pills" data-pd-group="{{ opt.position }}">
                  {%- for val in opt.values -%}
                    {%- assign is_sel = false -%}
                    {%- if opt.selected_value == val -%}{%- assign is_sel = true -%}{%- endif -%}
                    <button
                      type="button"
                      class="pdpill{% if is_sel %} is-selected{% endif %}"
                      data-pd-opt
                      data-pd-val="{{ val | escape }}"
                      aria-pressed="{% if is_sel %}true{% else %}false{% endif %}"
                    >{{ val }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- elsif gramaje != blank -%}
            {%- comment -%}
              Presentación única: el contenido va como dato, no como opción.
            {%- endcomment -%}
            <div class="pdopt">
              <span class="pdopt__label">{{ 'sections.producto.content' | t }}</span>
              <p class="pdgram">{{ gramaje }}</p>
            </div>
          {%- endif -%}
        </div>

        {%- if has_plans -%}
          {%- comment -%}
            Radios apilados (mejor que pastillas lado a lado: el nombre del plan
            más el precio no caben en una fila en móvil). El name de los radios
            NO es selling_plan: lo que viaja al carrito es el input oculto de
            abajo, que producto.js llena o deshabilita (un input deshabilitado
            no va en el FormData, así "compra única" no manda el campo).
          {%- endcomment -%}
          <fieldset class="pdplan" data-pd-plans>
            <legend class="pdopt__label">{{ 'sections.producto.plan_legend' | t }}</legend>

            {%- unless product.requires_selling_plan -%}
              <label class="pdplan__opt is-selected">
                <input class="pdplan__radio" type="radio" name="pd_plan" value="" data-pd-plan checked>
                <span class="pdplan__mark" aria-hidden="true"></span>
                <span class="pdplan__name">{{ 'sections.producto.plan_one_time' | t }}</span>
                <span class="pdplan__price" data-pd-plan-price="">{{ cur_variant.price | money }}</span>
              </label>
            {%- endunless -%}

            {%- assign plan_idx = 0 -%}
            {%- assign group_fallback = 'sections.producto.plan_group_fallback' | t -%}
            {%- for group in product.selling_plan_groups -%}
              {%- assign group_name = group.name | strip | default: group_fallback -%}
              {%- for alloc in cur_variant.selling_plan_allocations -%}
                {%- if alloc.selling_plan_group_id != group.id -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  assign plan = alloc.selling_plan
                  # La opción del plan ("Entregar cada mes") es más limpia que el
                  # nombre completo, que trae el descuento pegado.
                  assign plan_label = plan.options.first.value | default: plan.name
                  assign plan_checked = false
                  if product.requires_selling_plan and plan_idx == 0
                    assign plan_checked = true
                  endif
                -%}
                <label class="pdplan__opt{% if plan_checked %} is-selected{% endif %}">
                  <input class="pdplan__radio" type="radio" name="pd_plan" value="{{ plan.id }}" data-pd-plan{% if plan_checked %} checked{% endif %}>
                  <span class="pdplan__mark" aria-hidden="true"></span>
                  <span class="pdplan__name">
                    <strong>{{ group_name }}</strong> · {{ plan_label }}
                    {%- if plan.description != blank -%}
                      <small class="pdplan__desc">{{ plan.description }}</small>
                    {%- endif -%}
                  </span>
                  <span class="pdplan__price" data-pd-plan-price="{{ plan.id }}">{{ alloc.price | money }}</span>
                </label>
                {%- assign plan_idx = plan_idx | plus: 1 -%}
              {%- endfor -%}
            {%- endfor -%}

            <p class="pdplan__note">{{ 'sections.producto.plan_note' | t }}</p>
          </fieldset>
        {%- endif -%}

        <div class="pdbuyrow">
          <div class="pdstepper" data-pd-stepper>
            <button type="button" class="pdstepper__btn" data-pd-step="-1" aria-label="{{ 'sections.producto.qty_less' | t }}">−</button>
            <span class="pdstepper__val" data-pd-qty aria-live="polite">1</span>
            <button type="button" class="pdstepper__btn" data-pd-step="1" aria-label="{{ 'sections.producto.qty_more' | t }}">+</button>
          </div>

          {%- comment -%}
            La etiqueta viva del CTA la arma el JS: prefijo + lo que esté elegido.
            El data-prefix es lo único que se configura.
          {%- endcomment -%}
          <button
            type="submit"
            class="pdcta"
            data-pd-add
            data-prefix="{{ section.settings.cta_prefix | escape }}"
            data-prefix-plan="{{ section.settings.cta_prefix_plan | escape }}"
            data-label-added="{{ 'sections.producto.added' | t }}"
            data-label-soldout="{{ 'products.card.sold_out' | t }}"
            data-label-failed="{{ 'products.card.add_failed' | t }}"
            data-label-unavailable="{{ 'sections.producto.unavailable' | t }}"
          >{{ section.settings.cta_prefix }}</button>
        </div>

        <input type="hidden" name="id" value="{{ cur_variant.id }}" data-pd-variant>
        <input type="hidden" name="quantity" value="1" data-pd-qty-input>
        {%- if has_plans -%}
          {%- liquid
            # Arranca con el primer plan solo cuando el producto no se vende
            # suelto; si no, deshabilitado (= compra única) hasta que elijan.
            assign first_plan_id = cur_variant.selling_plan_allocations.first.selling_plan.id
          -%}
          <input
            type="hidden"
            name="selling_plan"
            value="{% if product.requires_selling_plan %}{{ first_plan_id }}{% endif %}"
            data-pd-plan-input
            {% unless product.requires_selling_plan %}disabled{% endunless %}
          >
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="pdnote">{{ section.settings.note }}</p>
        {%- endif -%}
      </form>

      {%- comment -%}
        Acordeón. El wrapper toma el alto que sobra y scrollea SOLO adentro:
        abrir una entrada no mueve ni el CTA ni la galería (ver producto.css).
      {%- endcomment -%}
      {%- assign acc_blocks = section.blocks | where: 'type', 'acordeon' -%}
      {%- if acc_blocks.size > 0 -%}
        <div class="pdacc">
          {%- for block in acc_blocks -%}
            {%- liquid
              # Cada entrada dice de qué metafield se llena. Si ese metafield
              # está vacío (producto sin etiqueta cargada), cae al texto del
              # bloque; si tampoco hay, la entrada no se dibuja.
              assign src = block.settings.source
              assign acc_body = blank
              if src == 'ingredientes'
                assign acc_body = mf.ingredientes.value
              elsif src == 'recomendacion'
                assign acc_body = mf.recomendacion.value
              elsif src == 'instrucciones'
                assign acc_body = mf.instrucciones.value
              endif

              # La tabla del análisis garantizado solo acompaña a ingredientes.
              assign show_analisis = false
              if src == 'ingredientes' and mf.proteina_cruda.value != blank
                assign show_analisis = true
              endif
            -%}
            {%- if acc_body != blank or block.settings.body != blank -%}
              {%- comment -%} Todos los acordeones arrancan cerrados: la ficha se lee de un vistazo y el usuario abre lo que le interese. {%- endcomment -%}
              <details class="pdacc__item" {{ block.shopify_attributes }}>
                <summary class="pdacc__head">
                  {{ block.settings.title }}
                  <span class="pdacc__sign" aria-hidden="true"></span>
                </summary>
                <div class="pdacc__body">
                  {%- if acc_body != blank -%}
                    <p>{{ acc_body | newline_to_br }}</p>
                  {%- else -%}
                    {{ block.settings.body }}
                  {%- endif -%}

                  {%- if show_analisis -%}
                    <dl class="pdanalisis">
                      {%- comment -%}
                        Claves y etiquetas van en dos listas paralelas: una
                        clave de traducción armada al vuelo no la puede
                        verificar `shopify theme check`.
                      {%- endcomment -%}
                      {%- assign an_keys = 'proteina_cruda,grasa_cruda,fibra_cruda,humedad,cenizas,eln' | split: ',' -%}
                      {%- assign an_labels = 'sections.producto.analysis_labels' | t | split: ',' -%}
                      {%- for k in an_keys -%}
                        {%- liquid
                          assign raw = mf[k].value
                          if raw != blank
                            # 72.0 se ve mal en una etiqueta: si el número es
                            # entero se muestra entero, y si no, con decimales.
                            assign num = raw | times: 1
                            assign whole = num | round
                            if num == whole
                              assign num_txt = whole
                            else
                              assign num_txt = num | round: 2
                            endif
                          endif
                        -%}
                        {%- if raw != blank -%}
                          <div class="pdanalisis__row">
                            <dt>{{ an_labels[forloop.index0] }}</dt>
                            <dd>{{ num_txt }}%</dd>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </dl>
                  {%- endif -%}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    ---------- 2. Cinturón de beneficios ----------
    Los beneficios cambian por producto, así que mandan los del metafield
    custom.beneficios (lista de metaobjetos "Beneficio", reutilizables entre
    productos). Si el producto todavía no tiene ninguno cargado, caen los
    bloques de la sección: ninguna página se queda sin cinturón.
  {%- endcomment -%}
  {%- liquid
    assign product_benefits = product.metafields.custom.beneficios.value
    assign belt_blocks = section.blocks | where: 'type', 'beneficio'

    # Con los cinco beneficios completos la tira va a cinco columnas parejas;
    # con menos, auto-fit reparte los que haya sin dejar huérfanos (la clase
    # decide en CSS — contar aquí evita depender de :has()).
    if product_benefits != blank and product_benefits.size > 0
      assign belt_count = product_benefits.size
    else
      assign belt_count = belt_blocks.size
    endif
    assign belt_grid_class = 'pdbelt__grid'
    if belt_count >= 5
      assign belt_grid_class = 'pdbelt__grid pdbelt__grid--cinco'
    endif
  -%}

  {%- comment -%}
    Cada beneficio es ícono arriba + afirmación corta, nada de párrafo: el
    cinturón se lee de un vistazo. El campo de texto largo sigue existiendo en
    el metaobjeto y en el bloque (para no perder lo ya cargado) pero no se
    pinta. Sin ícono, el ítem se dibuja solo con su texto — sin hueco reservado.
  {%- endcomment -%}
  {%- if product_benefits != blank and product_benefits.size > 0 -%}
    <div class="pdbelt">
      <div class="{{ belt_grid_class }}">
        {%- for benefit in product_benefits -%}
          <article class="pdbelt__item">
            {%- if benefit.icono.value != blank -%}
              <img class="pdbelt__icon" src="{{ benefit.icono.value | image_url: width: 192 }}" alt="" aria-hidden="true" width="96" height="96" loading="lazy">
            {%- endif -%}
            <h3 class="pdbelt__title">{{ benefit.titulo.value }}</h3>
          </article>
        {%- endfor -%}
      </div>
    </div>
  {%- elsif belt_blocks.size > 0 -%}
    <div class="pdbelt">
      <div class="{{ belt_grid_class }}">
        {%- for block in belt_blocks -%}
          <article class="pdbelt__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <img class="pdbelt__icon" src="{{ block.settings.icon | image_url: width: 192 }}" alt="" aria-hidden="true" width="96" height="96" loading="lazy">
            {%- endif -%}
            <h3 class="pdbelt__title">{{ block.settings.title }}</h3>
          </article>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}
    ---------- 3. Opiniones de los clientes ----------
    La tienda no tiene app de reviews, así que las opiniones ya cargadas viven
    como bloques del customizer (mismo criterio que las tarjetas de respaldo de
    la venta cruzada). Sin ningún bloque la sección se dibuja en su estado
    vacío: las estrellas de contorno pasan a ser el selector que abre el popup.

    Lo que se publica desde el popup es de la sesión —entra a la lista, al
    promedio y al contador—, pero no se guarda en Shopify: sin backend de
    reviews no hay dónde.
  {%- endcomment -%}
  {%- liquid
    assign op_blocks = section.blocks | where: 'type', 'opinion'
    assign op_count = op_blocks.size

    # Promedio con aritmética entera: `round: 1` devuelve un float y un
    # promedio exacto de 4 se imprimiría "4", sin el decimal que pide el
    # diseño. op_tenths es el promedio ×10 ya redondeado (44 → "4.4"); de ahí
    # salen tanto el número como las estrellas llenas del encabezado, así que
    # los dos siempre concuerdan. El JS repite esta misma cuenta al publicar.
    assign op_sum = 0
    for op in op_blocks
      assign op_sum = op_sum | plus: op.settings.rating
    endfor
    if op_count > 0
      assign op_tenths = op_sum | times: 100 | divided_by: op_count | plus: 5 | divided_by: 10
      assign op_whole = op_tenths | divided_by: 10
      assign op_dec = op_tenths | modulo: 10
      assign op_avg = op_whole | append: '.' | append: op_dec
      assign op_full = op_tenths | plus: 5 | divided_by: 10
    endif

    # De entrada se ven tres; el botón de abajo suma de cinco en cinco (JS).
    # En el customizer se dibujan todas: si no, una opinión recién agregada
    # nacería oculta y el cliente no vería lo que acaba de escribir.
    assign op_shown = 3
    if request.design_mode
      assign op_shown = op_count
    endif
  -%}

  <div class="pdops" data-pd-reviews>
    <div class="pdops__inner">
      <div class="pdops__head">
        <div class="pdops__intro">
          <h2 class="pdops__title">{{ section.settings.reviews_title }}</h2>

          {%- comment -%}
            El bloque de estrellas + promedio lo vuelve a dibujar el JS cuando
            se publica una opinión (de selector a promedio), así que este
            markup es el mismo que arma renderScore() en producto.js.
          {%- endcomment -%}
          <div class="pdops__score" data-pd-rev-score>
            {%- if op_count > 0 -%}
              {%- comment -%} Se lee el promedio exacto ("4.4 de 5"), no el redondeo de las estrellas — igual que renderScore(). {%- endcomment -%}
              <div class="pdops__stars" role="img" aria-label="{{ 'sections.producto.reviews_of_five' | t: count: op_avg }}">
                {%- for i in (1..5) -%}
                  <span class="pdops__star">{% if i <= op_full %}★{% else %}☆{% endif %}</span>
                {%- endfor -%}
              </div>
              <span class="pdops__avg">{{ op_avg }}</span>
            {%- else -%}
              <div class="pdops__stars" role="group" aria-label="{{ 'sections.producto.reviews_pick' | t }}">
                {%- for i in (1..5) -%}
                  {%- liquid
                    if i == 1
                      assign star_aria = 'sections.producto.reviews_star_one' | t
                    else
                      assign star_aria = 'sections.producto.reviews_star_many' | t: count: i
                    endif
                  -%}
                  <button type="button" class="pdops__star pdops__star--pick" data-pd-rev-pick="{{ i }}" aria-label="{{ star_aria }}">☆</button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          <p class="pdops__sub" data-pd-rev-sub>
            {%- if op_count == 0 -%}
              {{- 'sections.producto.reviews_first' | t -}}
            {%- elsif op_count == 1 -%}
              {{- 'sections.producto.reviews_one' | t -}}
            {%- else -%}
              {{- 'sections.producto.reviews_many' | t: count: op_count -}}
            {%- endif -%}
          </p>
        </div>

        <button type="button" class="pdops__cta" data-pd-rev-open>{{ 'sections.producto.reviews_write' | t }}</button>
      </div>

      {%- comment -%}
        La lista se dibuja siempre, aunque esté vacía: es donde el JS mete la
        primera opinión publicada. Vacía no se ve (`:empty` en producto.css),
        así que el estado vacío no muestra la regla de arriba.
      {%- endcomment -%}
      <div class="pdops__list" data-pd-rev-list>
        {%- for op in op_blocks -%}
          {%- assign op_r = op.settings.rating | times: 1 -%}
          <article
            class="pdops__item"
            data-pd-rev-item
            data-rating="{{ op_r }}"
            {% if forloop.index > op_shown %}hidden{% endif %}
            {{ op.shopify_attributes }}
          >
            <div class="pdops__istars" role="img" aria-label="{{ 'sections.producto.reviews_of_five' | t: count: op_r }}">
              {%- for i in (1..5) -%}{% if i <= op_r %}★{% else %}☆{% endif %}{%- endfor -%}
            </div>
            <p class="pdops__text">{{ op.settings.text }}</p>
            {%- if op.settings.autor != blank -%}
              <p class="pdops__meta">{{ op.settings.autor }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>

      {%- comment -%}
        "Ver menos" arranca siempre oculto: recién aparece cuando se abrió la
        lista con "ver más", y se va cuando vuelve a lo que se veía de entrada.
        Lo prende y lo apaga el JS, su texto nunca cambia.
      {%- endcomment -%}
      {%- assign op_rest = op_count | minus: op_shown -%}
      <div class="pdops__actions">
        <button type="button" class="pdops__more" data-pd-rev-more {% if op_rest < 1 %}hidden{% endif %}>
          {%- if op_rest == 1 -%}
            {{- 'sections.producto.reviews_more_one' | t -}}
          {%- else -%}
            {{- 'sections.producto.reviews_more_many' | t: count: op_rest -}}
          {%- endif -%}
        </button>
        <button type="button" class="pdops__less" data-pd-rev-less hidden>
          {{- 'sections.producto.reviews_less' | t -}}
        </button>
      </div>
    </div>

    {%- comment -%}
      Popup. El velo es `position: fixed`, así que queda centrado en la ventana
      sin importar dónde esté el scroll: nada arriba de él lleva transform (ver
      producto.css). Arranca con [hidden] y el JS lo prende.
    {%- endcomment -%}
    <div class="pdops__veil" data-pd-rev-veil hidden>
      <div class="pdops__modal" role="dialog" aria-modal="true" aria-labelledby="pdops-modal-title">
        <div class="pdops__mhead">
          <div>
            <h2 class="pdops__mtitle" id="pdops-modal-title">{{ 'sections.producto.reviews_write' | t }}</h2>
            <p class="pdops__mprod">
              {{- title -}}
              {%- if gramaje != blank %} · {{ gramaje }}{% endif -%}
            </p>
          </div>
          <button type="button" class="pdops__x" data-pd-rev-close aria-label="{{ 'general.close' | t }}">×</button>
        </div>

        <form class="pdops__form" data-pd-rev-form>
          <span class="pdops__flabel">{{ 'sections.producto.reviews_pick' | t }}</span>
          <div class="pdops__pick" role="group" aria-label="{{ 'sections.producto.reviews_pick' | t }}" data-pd-rev-picker>
            {%- for i in (1..5) -%}
              {%- liquid
                if i == 1
                  assign star_aria = 'sections.producto.reviews_star_one' | t
                else
                  assign star_aria = 'sections.producto.reviews_star_many' | t: count: i
                endif
              -%}
              <button type="button" class="pdops__star pdops__star--pick" data-pd-rev-pick="{{ i }}" aria-label="{{ star_aria }}" aria-pressed="false">☆</button>
            {%- endfor -%}
          </div>

          <label class="visually-hidden" for="pdops-text">{{ 'sections.producto.reviews_placeholder' | t }}</label>
          <textarea
            class="pdops__field pdops__field--text"
            id="pdops-text"
            data-pd-rev-text
            placeholder="{{ 'sections.producto.reviews_placeholder' | t }}"
          ></textarea>

          <label class="visually-hidden" for="pdops-name">{{ 'sections.producto.reviews_name' | t }}</label>
          <input
            class="pdops__field"
            id="pdops-name"
            type="text"
            data-pd-rev-name
            placeholder="{{ 'sections.producto.reviews_name' | t }}"
          >

          <div class="pdops__foot">
            <button type="submit" class="pdops__submit">{{ 'sections.producto.reviews_submit' | t }}</button>
            <button type="button" class="pdops__cancel" data-pd-rev-close>{{ 'sections.producto.reviews_cancel' | t }}</button>
          </div>
        </form>
      </div>
    </div>

    {%- comment -%}
      Textos que arma el JS (contador, botón de "ver más", firma por defecto).
      Van como JSON —igual que las variantes de más abajo— y no hardcodeados en
      producto.js: el copy vive en locales/es.default.json. El '%s' es el hueco
      donde el JS mete el número.
    {%- endcomment -%}
    <script type="application/json" data-pd-rev-i18n>
      {
        "first": {{ 'sections.producto.reviews_first' | t | json }},
        "one": {{ 'sections.producto.reviews_one' | t | json }},
        "many": {{ 'sections.producto.reviews_many' | t: count: '%s' | json }},
        "more_one": {{ 'sections.producto.reviews_more_one' | t | json }},
        "more_many": {{ 'sections.producto.reviews_more_many' | t: count: '%s' | json }},
        "of_five": {{ 'sections.producto.reviews_of_five' | t: count: '%s' | json }},
        "pick": {{ 'sections.producto.reviews_pick' | t | json }},
        "star_one": {{ 'sections.producto.reviews_star_one' | t | json }},
        "star_many": {{ 'sections.producto.reviews_star_many' | t: count: '%s' | json }},
        "anon": {{ 'sections.producto.reviews_anon' | t | json }}
      }
    </script>
  </div>

  {%- comment -%} ---------- 4. Venta cruzada ---------- {%- endcomment -%}
  <div class="pdcross">
    <div class="pdcross__inner">
      <div class="pdcross__head">
        <h2 class="pdcross__title">{{ section.settings.cross_title }}</h2>
        {%- if section.settings.cross_link_label != blank -%}
          <a class="pdcross__link" href="{{ section.settings.cross_link_url | default: routes.all_products_collection_url }}">
            {{- section.settings.cross_link_label -}}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} .cardset: activa los estilos de la tarjeta (base.css). {%- endcomment -%}
      <div class="pdcross__grid cardset">
        {%- liquid
          # Collection-driven con fallback. Si el customizer no eligió colección,
          # se usa la del propio producto (productos-perros / productos-gatos):
          # así un snack de perro se cruza con perros y uno de gato con gatos, y
          # cualquier producto nuevo entra solo sin tocar la plantilla.
          assign xcoll = section.settings.cross_collection
          if xcoll == blank
            for c in product.collections
              if c.handle contains 'productos-'
                assign xcoll = c
                break
              endif
            endfor
          endif
          assign cross_blocks = section.blocks | where: 'type', 'cruzada'
          # Assets de respaldo, en el orden de las tarjetas del diseño.
          assign fallback_cards = 'bungot-higado.webp,bungot-patas.webp,bungot-sticker-manada.webp' | split: ','
          # Cuenta aparte del forloop: hay que saltarse el producto que se está
          # viendo, así que el límite no puede ir en el for. Cuatro tarjetas:
          # es lo que cabe en una fila a lo ancho del contenedor (ver
          # .pdcross__grid en producto.css).
          assign shown = 0
          assign cross_max = 4
        -%}

        {%- comment -%}
          Es la MISMA tarjeta del catálogo: snippets/banda-card.liquid, estilos
          en base.css bajo .cardset. Nada de una tarjeta propia de la PDP — si
          cambia la del catálogo, cambia esta sola.
        {%- endcomment -%}
        {%- if xcoll != blank and xcoll.products.size > 1 -%}
          {%- for xp in xcoll.products -%}
            {%- if xp.id == product.id -%}{%- continue -%}{%- endif -%}
            {%- if shown >= cross_max -%}{%- break -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- liquid
              capture xcolor
                render 'card-color', product: xp, index: forloop.index0
              endcapture

              # El antetítulo sale del MISMO metafield que en el catálogo
              # (custom.card_eyebrow): si el producto no lo trae, la tarjeta va
              # sin pastilla, igual que allá. Antes se armaba aquí con
              # beneficio + gramaje y por eso estas tarjetas se veían distintas.
              assign xp_eyebrow = xp.metafields.custom.card_eyebrow.value

              assign xp_price = blank
              if xp.price > 0
                assign xp_price = xp.price | money
              endif

              # Solo-suscripción: el agregado rápido lleva su primer plan.
              assign xp_sp = ''
              if xp.requires_selling_plan
                assign xp_sp = xp.selected_or_first_available_variant.selling_plan_allocations.first.selling_plan.id
              endif
            -%}
            {%- render 'banda-card',
              media_color: xcolor,
              image: xp.featured_image,
              title: xp.title,
              eyebrow: xp_eyebrow,
              price_html: xp_price,
              url: xp.url,
              variant_id: xp.selected_or_first_available_variant.id,
              available: xp.available,
              selling_plan_id: xp_sp,
              cta: section.settings.cta_prefix
            -%}
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Respaldo: tarjetas manuales, sin link ni carrito. {%- endcomment -%}
          {%- for block in cross_blocks -%}
            {%- liquid
              assign card_img = block.settings.image
              if card_img == blank
                assign card_asset = fallback_cards[forloop.index0]
              else
                assign card_asset = blank
              endif
            -%}
            {%- render 'banda-card',
              media_color: block.settings.color,
              image: card_img,
              fallback_asset: card_asset,
              title: block.settings.title,
              eyebrow: block.settings.detail,
              price_html: block.settings.price,
              url: block.settings.url,
              cta: section.settings.cta_prefix
            -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Variantes reales para el JS (precio/id/disponibilidad). {%- endcomment -%}
  {%- if use_real_options -%}
    <script type="application/json" data-pd-variants>
      [{% for v in product.variants %}{% unless forloop.first %},{% endunless %}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available }},"price":{{ v.price | money | json }},"plans":[{% for a in v.selling_plan_allocations %}{% unless forloop.first %},{% endunless %}[{{ a.selling_plan.id | json }},{{ a.price | money | json }}]{% endfor %}]}{% endfor %}]
    </script>
  {%- endif -%}
</section>

<script src="{{ 'producto.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Producto BUNGOT",
  "tag": "section",
  "max_blocks": 50,
  "settings": [
    { "type": "paragraph", "content": "Split fijo 50/50: galería a la izquierda, compra a la derecha. Los campos vacíos se llenan con los datos del producto." },

    { "type": "header", "content": "Panel de la galería" },
    { "type": "color", "id": "family_color", "label": "Color de la familia", "info": "Déjalo vacío: así la galería toma el color de la familia del producto en el catálogo (Configuración del tema → Familias del catálogo). Si lo llenas, TODAS las páginas de producto con esta plantilla salen de este color." },
    { "type": "image_picker", "id": "bag_image", "label": "Foto principal", "info": "Vacío = la foto principal del producto." },
    { "type": "text", "id": "lote", "label": "Línea de lote", "default": "Lote 04 · Guadalajara" },

    { "type": "header", "content": "Compra" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Premios deshidratados" },
    { "type": "text", "id": "title", "label": "Título", "info": "Vacío = el nombre del producto." },
    { "type": "textarea", "id": "lead", "label": "Párrafo", "info": "Vacío = la descripción del producto." },
    { "type": "text", "id": "cta_prefix", "label": "Texto del botón", "default": "Agregar", "info": "Al lado se agrega solo lo que esté elegido." },
    { "type": "text", "id": "cta_prefix_plan", "label": "Texto del botón con suscripción", "default": "Suscribirme", "info": "Se usa cuando el cliente elige un plan de suscripción (Shopify Subscriptions)." },
    { "type": "text", "id": "note", "label": "Línea debajo del botón", "default": "Precio por confirmar · envío gratis desde $500" },

    { "type": "header", "content": "Cifras" },
    { "type": "text", "id": "stat1_value", "label": "Cifra 1", "default": "62%" },
    { "type": "text", "id": "stat1_label", "label": "Etiqueta 1", "default": "Proteína" },
    { "type": "text", "id": "stat2_value", "label": "Cifra 2", "default": "1" },
    { "type": "text", "id": "stat2_label", "label": "Etiqueta 2", "default": "Ingrediente" },
    { "type": "text", "id": "stat3_value", "label": "Cifra 3", "default": "0" },
    { "type": "text", "id": "stat3_label", "label": "Etiqueta 3", "default": "Conservadores" },

    { "type": "header", "content": "Opiniones" },
    { "type": "text", "id": "reviews_title", "label": "Título", "default": "Opiniones de los clientes", "info": "Las opiniones se cargan como bloques \"Opinión\". Sin ninguno, la sección invita a dejar la primera." },

    { "type": "header", "content": "Venta cruzada" },
    { "type": "text", "id": "cross_title", "label": "Título", "default": "La manada también se lleva" },
    { "type": "text", "id": "cross_link_label", "label": "Link", "default": "Ver todos los productos" },
    { "type": "url", "id": "cross_link_url", "label": "Destino del link", "info": "Vacío = todos los productos." },
    { "type": "collection", "id": "cross_collection", "label": "Colección", "info": "Vacío = se usan las tarjetas de abajo." }
  ],
  "blocks": [
    {
      "type": "acordeon",
      "name": "Acordeón",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Ingredientes y análisis" },
        {
          "type": "select",
          "id": "source",
          "label": "De dónde sale el contenido",
          "default": "ingredientes",
